# Copy this file to .env and fill in the values.
# NEVER commit .env.

# --- AWS -------------------------------------------------------------------
# Region where Bedrock model access is enabled.
AWS_REGION=us-east-1

# Optional: use a named profile from ~/.aws/config (e.g. from `aws configure sso`).
# Leave commented out to use the default credential chain.
# AWS_PROFILE=shambashield

# --- Amazon Bedrock --------------------------------------------------------
# Run `python scripts/check_bedrock.py --list` to see available model IDs,
# then paste one that your account can invoke.
BEDROCK_MODEL_ID=

# Optional: a stronger model for the orchestrator. Falls back to BEDROCK_MODEL_ID.
BEDROCK_ORCHESTRATOR_MODEL_ID=

# Optional: Bedrock API key (bearer token) as an alternative to IAM/SSO.
# Generate it in the Bedrock console. Less preferred than SSO; never commit it.
# BEDROCK_API_KEY=

# --- Application -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- Open-Meteo ------------------------------------------------------------
OPEN_METEO_TIMEOUT_SECONDS=15

# Force the labelled demo forecast even when the API is reachable.
FORCE_DEMO_DATA=false
